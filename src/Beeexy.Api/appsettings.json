{
  "ConnectionStrings": {
    "BeeexyDatabase": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Authentication": {
    "EmailChallenge": {
      "CodeLength": 6,
      "LifetimeMinutes": 10,
      "EmailPermitLimit": 3,
      "IpPermitLimit": 20,
      "RateLimitWindowMinutes": 15,
      "OtpHashingKey": ""
    },
    "EmailSender": {
      "Provider": "Unavailable"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
