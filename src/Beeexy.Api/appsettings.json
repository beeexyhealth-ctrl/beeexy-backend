{
  "ConnectionStrings": {
    "BeeexyDatabase": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Authentication": {
    "EmailChallenge": {
      "CodeLength": 6,
      "LifetimeMinutes": 10,
      "EmailPermitLimit": 3,
      "IpPermitLimit": 20,
      "MaximumVerificationAttempts": 5,
      "RateLimitWindowMinutes": 15,
      "OtpHashingKey": ""
    },
    "EmailSender": {
      "Provider": "Unavailable"
    },
    "Google": {
      "Enabled": false,
      "ClientId": ""
    },
    "Tokens": {
      "Issuer": "https://api.beeexy.com",
      "Audience": "beeexy-client",
      "SigningKey": "",
      "AccessTokenLifetimeMinutes": 15,
      "RefreshTokenLifetimeDays": 30
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
